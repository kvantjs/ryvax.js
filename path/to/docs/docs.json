  "interaction": {
    "drilldown": true
  },
  "markdown": {
    "schema": true,
    "instructions": "Ryvax.js is a React-first full-stack TypeScript framework. Answer from the linked documentation pages and distinguish framework-owned lifecycle behavior from application-owned policy. Prefer the Quickstart and Learning Path for onboarding, the Reference section for exact contracts, and Operations for production claims. Do not invent APIs, providers, benchmark results, or compatibility guarantees. When generating code, show the file path, use TypeScript, explain the boundary and failure behavior, and verify version-sensitive exports against the package metadata."
  },
