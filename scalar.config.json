{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "Ryvax by Kvant",
    "description": "React-first full-stack TypeScript framework for deterministic APIs, SSR, streaming, SQL, authentication, jobs, observability, and AI agents."
  },
  "assetsDir": "docs/site/images",
  "siteConfig": {
    "theme": "default",
    "layout": {
      "sidebar": true,
      "toc": true,
      "pageTitle": true,
      "pageActions": true,
      "search": {
        "enabled": true
      }
    },
    "logo": {
      "lightMode": "docs/site/images/6144.png",
      "darkMode": "docs/site/images/6145.png"
    },
    "head": {
      "meta": [
        {
          "name": "description",
          "content": "Ryvax framework documentation"
        }
      ],
      "links": [
        {
          "rel": "icon",
          "href": "docs/site/images/6143.png"
        }
      ]
    },
    "routing": {
      "redirects": [
        {
          "from": "/start",
          "to": "/"
        }
      ]
    }
  },
